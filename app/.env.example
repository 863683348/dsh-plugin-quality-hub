# ===== 数据库（Neon PostgreSQL） =====
# 复制为 .env.local 并填入真实值（生产/预览环境请使用 Vercel 环境变量）
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@HOST-direct.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# ===== GitHub API =====
# 只读 Personal Access Token（提升限流 60 -> 5000 次/小时）
# 获取: GitHub Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=""

# ===== Vercel KV (Upstash Redis) =====
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ===== 站点 =====
NEXT_PUBLIC_SITE_URL="https://dshquality.com"

# ===== Google Analytics 4（GA4 站点统计） =====
# 在 GA4 管理 -> 数据流 -> Web 中获取 Measurement ID
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ===== 内部端点认证（POST /api/v1/refresh） =====
# 用于 GitHub Actions cron / 手动刷新触发；长度建议 >= 32 字符
CRON_SECRET="crn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ===== Buttondown（DSH Weekly 邮件分发，v0.2） =====
# 未配置时订阅仍会本地落库（status=pending），配置后自动同步到 Buttondown
# 获取: https://buttondown.com/settings -> API 密钥
BUTTONDOWN_API_KEY=""
