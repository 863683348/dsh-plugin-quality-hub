import { runRefresh } from "../src/services/refresh-service";
import { readFileSync } from "fs";

// Manually load .env.local
const envPath = "C:/Users/l'x/WorkBuddy/2026-08-17-21-54-54/app/.env.local";
const envContent = readFileSync(envPath, "utf8");
for (const line of envContent.split("\n")) {
  const trimmed = line.trim();
  if (!trimmed || trimmed.startsWith("#")) continue;
  const eqIdx = trimmed.indexOf("=");
  if (eqIdx === -1) continue;
  const key = trimmed.slice(0, eqIdx);
  let value = trimmed.slice(eqIdx + 1);
  if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
    value = value.slice(1, -1);
  }
  process.env[key] = value;
}

console.log("GITHUB_TOKEN:", process.env.GITHUB_TOKEN ? "set" : "empty");
console.log("DATABASE_URL:", process.env.DATABASE_URL ? "set" : "empty");
console.log("KV:", process.env.KV_REST_API_URL ? "set" : "empty");

const result = await runRefresh("manual");
console.log(JSON.stringify(result, null, 2));
