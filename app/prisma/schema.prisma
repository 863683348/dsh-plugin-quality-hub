// DSH Plugin Quality Hub — Prisma Schema
// 依据: Spec v1.0 第 6 节 + docs/api/db-schema.md
// 数据库: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Plugin {
  id          String    @id @default(cuid())
  name        String    @unique // "owner/repo"
  owner       String
  repoName    String
  githubUrl   String    @unique
  npmName     String?
  description String?
  score       Int       @default(0) // 0-100
  grade       String    @default("F") // A/B/C/D
  maintenance Int       @default(0) // /30
  docs        Int       @default(0) // /25
  npm         Int       @default(0) // /30
  ecosystem   Int       @default(0) // /15
  flags       Json      @default("[]") // SecurityFlag[]
  stars       Int       @default(0)
  lastPush    DateTime?
  archived    Boolean   @default(false)
  // v1.1 snapshot fields (change-triggered re-evaluation)
  npmVersion  String? // npm dist-tags.latest at last eval (change trigger)
  evalSource  String   @default("seed") // seed | github | synthetic | re-eval
  lastEvalAt  DateTime? // when this plugin was last scored
  evalMeta    Json     @default("{}") // per-source metadata (e.g. github search query, synthetic batch)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scoreLogs   ScoreLog[]

  @@index([score], name: "idx_score")
  @@index([grade], name: "idx_grade")
  @@index([lastPush], name: "idx_last_push")
  @@index([evalSource], name: "idx_eval_source")
  @@map("plugins")
}

model ScoreLog {
  id        String   @id @default(cuid())
  pluginId  String
  plugin    Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  score     Int
  grade     String
  details   Json
  createdAt DateTime @default(now())

  @@index([pluginId, createdAt], name: "idx_plugin_score")
  @@map("score_logs")
}

// DSH Weekly newsletter subscribers (v0.2, Buttondown sync)
// Local table is the source of truth; Buttondown is the delivery channel.
// When BUTTONDOWN_API_KEY is missing, local rows are kept as pending until sync.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en") // en | zh
  status    String   @default("subscribed") // subscribed | pending | unsubscribed
  source    String   @default("web") // web | footer | home
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status], name: "idx_subscriber_status")
  @@map("newsletter_subscribers")
}

// CVE-style security advisories (v0.3)
// DSH-SA-YYYY-NNN format, published when a dangerous pattern is confirmed.
// Linked to a plugin via pluginName (name = "owner/repo" on Plugin).
model SecurityAdvisory {
  id            String   @id @default(cuid())
  advisoryId    String   @unique // e.g. "DSH-SA-2026-001"
  title         String
  severity      String   @default("high") // critical | high | medium | low
  pluginName    String // "owner/repo", references Plugin.name
  description   String
  affectedRange String   @default("all versions") // e.g. "< 1.2.0", "<= 0.9.4"
  status        String   @default("active") // active | resolved | investigating
  publishedAt   DateTime @default(now())
  resolvedAt    DateTime?
  updatedAt     DateTime @updatedAt

  @@index([severity], name: "idx_advisory_severity")
  @@index([status], name: "idx_advisory_status")
  @@index([pluginName], name: "idx_advisory_plugin")
  @@map("security_advisories")
}

// Refresh pipeline execution log (Spec §6.1 / refresh-service.ts)
model RefreshLog {
  id              String    @id @default(cuid())
  trigger         String    @default("manual") // cron | manual | deploy
  status          String    @default("running") // running | success | failed
  pluginsFetched  Int       @default(0)
  pluginsUpdated  Int       @default(0)
  error           String?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([status, createdAt], name: "idx_refresh_status_time")
  @@map("refresh_logs")
}

// ============================================================
// Tutorials 教程中心 (v1.2 新增)
// 双语: En/Zh 双列标量; content* 为 Markdown 子集(自研渲染器 src/lib/markdown.ts)
// 互链: String[] 数组列(编辑策展, 量小低频, 不建关系表; seed 断言保证引用完整)
// ============================================================
model Tutorial {
  id        String   @id @default(cuid())
  slug      String   @unique // "write-first-plugin"
  status    String   @default("published") // published | backlog (backlog 不渲染)
  level     String   @default("beginner") // beginner | intermediate | advanced
  order     Int      @default(0) // 列表排序(同 status 内升序)
  titleEn   String
  titleZh   String
  excerptEn String
  excerptZh String
  contentEn String // Markdown 子集正文
  contentZh String
  readingMinutes Int @default(5)

  // Content Silo 互链: 编辑人工策展的上下文引用
  relatedExampleSlugs String[] @default([]) // -> Example.slug
  relatedPluginNames  String[] @default([]) // -> Plugin.name ("owner/repo")

  publishedAt DateTime? // backlog 为空
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, level], name: "idx_tutorial_status_level")
  @@index([status, order], name: "idx_tutorial_status_order")
  @@map("tutorials")
}

// ============================================================
// Examples 实例库 (v1.2 新增)
// 三维度拆解: config / code / highlights, 各为 Markdown 子集文本
// pluginName 松散引用 Plugin.name (对齐 SecurityAdvisory 既有约定, 不建 FK)
// ============================================================
model Example {
  id        String @id @default(cuid())
  slug      String @unique // "dsh-web-ui"
  status    String @default("published") // published | draft
  pluginName String // "owner/repo", 松散引用, 不建 FK relation
  category  String // awesome 11 类键值(见 src/lib/content-constants.ts)

  titleEn   String
  titleZh   String
  excerptEn String
  excerptZh String

  // 三维度拆解卡(每卡一段 Markdown)
  configEn     String // 配置片段(典型为 json 代码块)
  configZh     String
  codeEn       String // 核心代码逻辑(典型为 ts 代码块)
  codeZh       String
  highlightsEn String // 评分亮点(典型为列表)
  highlightsZh String

  relatedTutorialSlugs String[] @default([]) // 1-2 个关联教程

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category], name: "idx_example_category")
  @@index([pluginName], name: "idx_example_plugin")
  @@index([status], name: "idx_example_status")
  @@map("examples")
}
